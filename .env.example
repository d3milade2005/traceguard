# Development credentials only. Keep credentials consistent with the URLs below.
APP_NAME=Traceguard
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=[]
MAX_REQUEST_BODY_BYTES=10485760

POSTGRES_USER=traceguard
POSTGRES_PASSWORD=traceguard_dev
POSTGRES_DB=traceguard
DATABASE_URL=postgresql+psycopg://traceguard:traceguard_dev@localhost:5432/traceguard

RABBITMQ_DEFAULT_USER=traceguard
RABBITMQ_DEFAULT_PASS=traceguard_dev
RABBITMQ_DEFAULT_VHOST=traceguard
RABBITMQ_URL=amqp://traceguard:traceguard_dev@localhost:5672/traceguard

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DEPENDENCY_TIMEOUT_SECONDS=3
WORKER_CONCURRENCY=2

# Optional; integration tests require an existing, disposable database.
# TEST_DATABASE_URL=postgresql+psycopg://traceguard:traceguard_dev@localhost:5432/traceguard_test
# TEST_RABBITMQ_URL=amqp://traceguard:traceguard_dev@localhost:5672/traceguard

# Worker soft timeout; hard timeout is +10s, database claim lease is +30s.
NORMALIZATION_TIMEOUT_SECONDS=60

# AnalysisContext JSON budget in UTF-8 bytes, including evidence and metadata.
# Reserved space is left for the future attribution request envelope.
ANALYSIS_CONTEXT__BUDGET=65536
ANALYSIS_CONTEXT__RESERVED_HEADROOM=4096
ANALYSIS_CONTEXT__HEAD_STEPS=2
ANALYSIS_CONTEXT__TAIL_STEPS=4
ANALYSIS_CONTEXT__NEIGHBOUR_STEPS=1

# Required only when an explicitly requested attribution executes in the worker.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=4096

# Explicit regression synthesis uses the same provider settings; budgets count UTF-8 bytes.
REGRESSION_MAX_INPUT_BYTES=48000
REGRESSION_MAX_SCENARIO_BYTES=16000

# Opt-in only: one request from an existing real attribution in a migrated _test database.
# RUN_LIVE_REGRESSION_TESTS=false
# LIVE_REGRESSION_ATTRIBUTION_ID=<completed-attribution-uuid>
